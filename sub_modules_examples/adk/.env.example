# Which Google backend to talk to: ai_studio | vertex | vertex_express | mock
# Run `python backend/auth.py` to find out which of these actually work.
NITYAM_AUTH=vertex_express

# Live model, bare name — auth.py expands it to the full Vertex resource path.
#   vertex/vertex_express : gemini-live-2.5-flash          (verified working)
#   ai_studio             : gemini-2.5-flash-native-audio-latest
# The native-audio models are not provisioned for this project (1008).
NITYAM_MODEL=gemini-live-2.5-flash

# Non-live model used only by the credential preflight.
NITYAM_PROBE_MODEL=gemini-3.7-flash

GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=your-key-from-aistudio.google.com/apikey
GOOGLE_OAUTH_ACCESS_TOKEN=your-oauth-access-token  # expires ~1h; this is the one vertex_express uses
