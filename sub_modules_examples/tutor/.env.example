# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# This project's working setup: Vertex AI Express Mode — an api_key alone,
# no gcloud/ADC, no project/location (their presence flips the SDK onto the
# ADC path and the key is ignored). Both env var names are set since
# different SDK versions/docs read one or the other. Independently confirmed
# by sub_modules_examples/shruti (shruti/cli.py) and sub_modules_examples/adk
# (backend/auth.py's vertex_express mode) — see architecture.md "Auth".
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_API_KEY=your-vertex-express-api-key-here

# Full Vertex AI (ADC), if you have gcloud set up instead:
# unset GOOGLE_API_KEY above, then:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Plain Gemini Developer API / AI Studio key — NOT recommended here: this
# project's AI Studio prepay credits are separately exhausted from its
# Vertex billing, so this path 429s (RESOURCE_EXHAUSTED) even when Vertex
# Express Mode above works fine.
# GEMINI_API_KEY=your-api-key-here

# Storage backends (memory_layer.md v2.0 / google_cloud_storage_integration.md).
# These use ADC (`gcloud auth application-default login`), a SEPARATE
# credential path from GOOGLE_API_KEY above — deliberately a different env
# var name (GCP_PROJECT, not GOOGLE_CLOUD_PROJECT) so it can never collide
# with the Express Mode switch above.
GCP_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=smriti
GCS_BUCKET=your-gcs-bucket-name
REDIS_HOST=localhost
REDIS_PORT=6379
