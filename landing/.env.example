# Where the tutor app actually lives, so the landing page's CTAs point at
# it instead of assuming localhost. backend/run.sh passes this explicitly
# when it starts the landing page alongside the tutor — see
# app/lib/config.ts. Defaults to http://localhost:5173 if unset.
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Not something to set by hand: .env.local also holds a VERCEL_OIDC_TOKEN,
# written automatically by the Vercel CLI (`vercel dev` / `vercel env pull`)
# and rotated on its own. It isn't a real app config value, which is why it
# isn't documented here.
