            {
              "id": "a_sameplace",
              "span": "land in the same place",
              "concept": "projectile.max_range",
              "note": "30° and 60° are complementary — identical range."
            },
            {
              "id": "a_highest",
              "span": "goes highest",
              "concept": "projectile.max_height"
            }
          ]
        },
