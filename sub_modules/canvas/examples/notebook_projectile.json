    {
      "page": 1,
      "label": "Splitting the velocity",
      "blocks": [
        {
          "type": "heading",
          "id": "b_h1",
          "text": "Where the vertical component comes in"
        },
        {
          "type": "tutor_text",
          "id": "b_t1",
          "text": "When you throw something at an angle, its speed is doing two jobs at once. The vertical component decides how high it goes and how long it stays up. The horizontal component decides how far it travels in that time. Nothing pushes it sideways, so the horizontal component never changes.",
          "anchors": [
            {
              "id": "a_vertcomp",
              "span": "vertical component",
              "concept": "vector.decomposition",
              "note": "u sinθ — the part of the launch speed pointing straight up."
            },
            {
              "id": "a_horizcomp",
              "span": "horizontal component",
              "concept": "vector.decomposition",
              "note": "u cosθ — constant for the whole flight."
            },
            {
              "id": "a_never",
              "span": "never changes",
              "concept": "projectile.independence_xy",
              "note": "The independence of x and y motion."
            }
          ]
        },
        {
          "type": "diagram",
          "id": "b_d1",
          "svg": "<svg viewBox=\"0 0 560 220\" role=\"img\" aria-label=\"A launch velocity arrow decomposed into a horizontal and a vertical component.\">\n  <defs>\n    <marker id=\"ah-u\"  viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6.5\" markerHeight=\"6.5\" orient=\"auto\"><path d=\"M0 0 L10 5 L0 10 z\" fill=\"var(--ink)\"/></marker>\n    <marker id=\"ah-ux\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6.5\" markerHeight=\"6.5\" orient=\"auto\"><path d=\"M0 0 L10 5 L0 10 z\" fill=\"var(--c-ux)\"/></marker>\n    <marker id=\"ah-uy\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6.5\" markerHeight=\"6.5\" orient=\"auto\"><path d=\"M0 0 L10 5 L0 10 z\" fill=\"var(--c-uy)\"/></marker>\n  </defs>\n\n  <line id=\"axis-ground\" x1=\"40\" y1=\"172\" x2=\"530\" y2=\"172\" stroke=\"currentColor\" stroke-width=\"1.5\" opacity=\".3\"/>\n\n  <g id=\"vec-ux\">\n    <line x1=\"70\" y1=\"172\" x2=\"256\" y2=\"172\" stroke=\"var(--c-ux)\" stroke-width=\"2.4\" stroke-dasharray=\"6 4\" marker-end=\"url(#ah-ux)\"/>\n    <text x=\"158\" y=\"196\" font-size=\"15\" font-weight=\"600\" fill=\"var(--c-ux)\" text-anchor=\"middle\">u<tspan dy=\"4\" font-size=\"10.5\">x</tspan></text>\n  </g>\n\n  <g id=\"vec-uy\">\n    <line x1=\"262\" y1=\"172\" x2=\"262\" y2=\"56\" stroke=\"var(--c-uy)\" stroke-width=\"2.4\" stroke-dasharray=\"6 4\" marker-end=\"url(#ah-uy)\"/>\n    <text x=\"288\" y=\"118\" font-size=\"15\" font-weight=\"600\" fill=\"var(--c-uy)\" text-anchor=\"middle\">u<tspan dy=\"4\" font-size=\"10.5\">y</tspan></text>\n  </g>\n\n  <g id=\"vec-u\">\n    <line x1=\"70\" y1=\"172\" x2=\"256\" y2=\"58\" stroke=\"var(--ink)\" stroke-width=\"2.8\" marker-end=\"url(#ah-u)\"/>\n    <text x=\"146\" y=\"100\" font-size=\"17\" font-weight=\"700\" fill=\"var(--ink)\" text-anchor=\"middle\">u</text>\n  </g>\n\n  <g id=\"angle-theta\">\n    <path d=\"M118 172 A 48 48 0 0 0 106 143\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" opacity=\".55\"/>\n    <text x=\"128\" y=\"158\" font-size=\"15\" fill=\"currentColor\" opacity=\".75\">&#952;</text>\n  </g>\n</svg>",
          "caption": "The launch velocity u, split into its two components.",
          "anchors": [
            {
              "id": "a_vec_u",
              "element": "#vec-u",
              "concept": "vector.decomposition",
              "note": "The full launch velocity."
            },
            {
              "id": "a_vec_ux",
              "element": "#vec-ux",
              "concept": "vector.decomposition",
              "note": "u cosθ, the horizontal component."
            },
            {
              "id": "a_vec_uy",
              "element": "#vec-uy",
              "concept": "vector.decomposition",
              "note": "u sinθ, the vertical component."
            },
            {
              "id": "a_theta",
              "element": "#angle-theta",
              "note": "The launch angle."
            }
          ]
        },
        {
          "type": "equation",
          "id": "b_e1",
          "terms": [
            {
              "id": "t_H",
              "tex": "H",
              "role": "maximum height",
              "concept": "projectile.max_height",
              "note": "How high it gets."
            },
            {
              "id": "t_eq",
              "tex": "=",
              "plain": true
            },
            {
              "id": "t_frac",
              "over": "(u sinθ)²",
              "tex": "2g",
              "concept": "projectile.max_height",
              "note": "The vertical component squared, over twice gravity.",
              "misconception": "misc.confuses_u_with_uy"
            }
          ]
        },
        {
          "type": "callout",
          "id": "b_c1",
          "tone": "prompt",
          "text": "Try it: highlight the part of that equation you are least sure about, then ask what it means.",
          "anchors": []
        }
      ]
    },
    {
      "page": 2,
      "label": "Comparing angles",
      "blocks": [
