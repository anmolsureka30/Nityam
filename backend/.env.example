# Which Google backend to talk to: ai_studio | vertex | vertex_express | mock
# Run `.venv/bin/python -m app.auth` to find out which of these actually work.
# mock needs no credentials at all and is what the tests run against.
NITYAM_AUTH=vertex_express

# Model ids live in app/config.py, verified live against client.models.list().
# Override here only to pin something different:
#   NITYAM_LIVE_MODEL=gemini-3.1-flash-live-preview
#   NITYAM_REASONING_MODEL=gemini-3.7-flash

# Non-live model used only by the credential preflight.
NITYAM_PROBE_MODEL=gemini-3.5-flash-lite

# The voice VoiceAgent speaks with.
NITYAM_VOICE=Aoede

# Tonight's topic. STUB — this comes from the class recap Shruti produces
# overnight once that pipeline is wired. See backend/INTEGRATION.md.
NITYAM_TOPIC_EYEBROW=Revision · today's class
NITYAM_TOPIC_HEADING=Maximum range — why 45° wins
NITYAM_TOPIC_CONCEPT=projectile.horizontal_range

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI Express Mode: the OAuth access token works as the api key and takes
# precedence. project/location must be ABSENT from the process env for this
# path — auth.py pops them after reading the project for the model path.
GOOGLE_API_KEY=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Ports. run.sh reads both; frontend/vite.config.ts reads NITYAM_API_PORT.
NITYAM_API_PORT=8210
NITYAM_WEB_PORT=5173

# Firebase web API key — same value as frontend/.env's VITE_FIREBASE_API_KEY.
# Not a secret (it identifies the project, not a credential), but tests need
# it to sign in as a fixed test account and get a real ID token. See
# backend/tests/_firebase_test_tokens.py.
FIREBASE_WEB_API_KEY=

# GCS bucket for durable ArtifactAgent output. Must already exist — see
# app/artifacts_gcs.py. `gcloud storage buckets list` to check what you have.
GCS_BUCKET=
