# Which Google backend to talk to: ai_studio | vertex | vertex_express | mock
# Run `.venv/bin/python -m app.auth` to find out which of these actually work.
# mock needs no credentials at all and is what the tests run against.
NITYAM_AUTH=vertex_express

# Model ids live in app/config.py, verified live against client.models.list().
# Override here only to pin something different:
#   NITYAM_LIVE_MODEL=gemini-3.1-flash-live-preview
#   NITYAM_REASONING_MODEL=gemini-3.7-flash

# Non-live model used only by the credential preflight.
NITYAM_PROBE_MODEL=gemini-3.5-flash-lite

# The voice VoiceAgent speaks with.
NITYAM_VOICE=Aoede

# Tonight's topic. STUB — this comes from the class recap Shruti produces
# overnight once that pipeline is wired. See backend/INTEGRATION.md.
NITYAM_TOPIC_EYEBROW=Revision · today's class
NITYAM_TOPIC_HEADING=Maximum range — why 45° wins
NITYAM_TOPIC_CONCEPT=projectile.horizontal_range

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI Express Mode: the OAuth access token works as the api key and takes
# precedence. project/location must be ABSENT from the process env for this
# path — auth.py pops them after reading the project for the model path.
GOOGLE_API_KEY=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Application Default Credentials (ADC) — a SEPARATE credential path from
# everything above. Needed for two things regardless of NITYAM_AUTH:
# verifying a student's Firebase sign-in (app/user_auth.py, every real
# connection) and Firestore (app/memory/store_firestore.py, only if
# NITYAM_STORE=firestore below). Nothing in this file substitutes for it —
# copying this .env to another machine will NOT make either of those work
# there. Set it up with EITHER:
#   gcloud auth application-default login          (you have GCP project access)
# or, if you don't:
#   export GOOGLE_APPLICATION_CREDENTIALS=/path/to/a-service-account-key.json
# See backend/README.md's "Google Cloud credentials" section before asking
# why Firestore or sign-in "isn't working" even with everything above filled in.
GOOGLE_APPLICATION_CREDENTIALS=

# Ports. run.sh reads both; frontend/vite.config.ts reads NITYAM_API_PORT.
NITYAM_API_PORT=8210
NITYAM_WEB_PORT=5173

# Firebase web API key — same value as frontend/.env's VITE_FIREBASE_API_KEY.
# Not a secret (it identifies the project, not a credential), but tests need
# it to sign in as a fixed test account and get a real ID token. See
# backend/tests/_firebase_test_tokens.py.
FIREBASE_WEB_API_KEY=

# GCS bucket for durable ArtifactAgent output. Must already exist — see
# app/artifacts_gcs.py. `gcloud storage buckets list` to check what you have.
GCS_BUCKET=

# Memorystore (Redis) for the workflow-tier turn buffer. Local dev: either
# `docker compose up -d redis` (see backend/docker-compose.yml) or a native
# `redis-server --daemonize yes --port 6379` — leave these at their defaults
# either way. Deployed: the Memorystore instance's private IP (Cloud Run
# reaches it via Direct VPC egress — see the memory-nityam-architecture docs).
REDIS_HOST=
REDIS_PORT=

# Give a brand-new sign-in the demo starting record on their first session —
# two prior sessions, a few graded concepts, two open doubts. On by default so
# that anyone signing in with their own account sees a tutor that already knows
# them rather than a blank slate. Set to 0 for anything resembling real use: a
# real student's first session should start empty, because every line of that
# record is a claim about a person.
NITYAM_SEED_NEW_STUDENTS=1
